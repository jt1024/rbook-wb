# 复制为 .env.local 并填入真实值；.env.local 已被 .gitignore 排除
# 初始超级管理员：仅在账号表为空时用于创建第一个 owner。
# 创建成功后请以该账号登录并在「账号与会话」中修改密码；此后登录只认数据库中的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<设置一个至少 10 位的初始口令>
ADMIN_DB_SECRET=<openssl rand -hex 32，需与云端 admin_write / admin_auth 函数内的哈希一致>

# 云服务连接配置（仅服务端读取；浏览器不再直连数据库 / LLM 网关）
CLOUD_ENDPOINT=<云服务 endpoint>
CLOUD_OAUTH_RELAY_BASE_URL=https://www.workbuddy.cn/v2/as/genie-baas/oauth
CLOUD_PUBLISHABLE_KEY=<wbpk_ 开头的 publishable key>
CLOUD_RESOURCE_ID=<wbcs_ 开头的资源 ID，可选>

# 站点规范地址：影响 canonical / OpenGraph / sitemap / JSON-LD。绑定自有域名后改这里即可
SITE_URL=https://classic-insight.app.workbuddy.host

# 说明：旧版自包含签名 cookie 使用的 SESSION_SECRET 已不再需要；
# 新会话是数据库记录，可在后台即时吊销，无需轮换密钥。
